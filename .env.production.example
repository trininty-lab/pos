APP_NAME="FAY COLLECTION"
VITE_APP_NAME="${APP_NAME}"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-production-domain.example.com
APP_VERSION=v2.4.0
RUN_MIGRATIONS=true
RUN_AUTH_SEEDERS=false

AUTH_PUBLIC_REGISTRATION=false
AUTH_REGISTER_THROTTLE=3,10
AUTH_FORGOT_PASSWORD_THROTTLE=5,10
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_URL=mysql://${MYSQLUSER}:${MYSQLPASSWORD}@${RAILWAY_TCP_PROXY_DOMAIN}:${RAILWAY_TCP_PROXY_PORT}/${MYSQLDATABASE}
DB_HOST=${RAILWAY_TCP_PROXY_DOMAIN}
DB_PORT=${RAILWAY_TCP_PROXY_PORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=pos_

REDIS_CLIENT=phpredis
REDIS_HOST=${REDISHOST}
REDIS_PASSWORD=${REDISPASSWORD}
REDIS_PORT=${REDISPORT}

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

WA_SERVICE_URL=http://whatsapp:3001
XENDIT_CALLBACK_TOKEN=
XENDIT_SECRET_KEY=
MIDTRANS_SERVER_KEY=
RESEND_KEY=

INERTIA_SSR_ENABLED=false
SECURITY_BOT_GUARD_ENABLED=true
